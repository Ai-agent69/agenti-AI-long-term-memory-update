# ============================================================
# Hybrid Agentic Memory System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Ollama ──────────────────────────────────────────────────
# Base URL of the local Ollama service
OLLAMA_HOST=http://127.0.0.1:11434

# Which Ollama model to use for memory classification and Baby chat.
# It must exactly match a tag shown by `ollama list`.
OLLAMA_MODEL=llama3.2:latest

# ── MongoDB ─────────────────────────────────────────────────
# Full MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/

# Database name
MONGODB_DATABASE=agentic_memory

# ── Analysis Thresholds (optional overrides) ─────────────────
# Minimum context score to consider input contextually relevant (0.0–1.0)
CONTEXT_THRESHOLD=0.3

# Minimum importance score (0.0–1.0)
IMPORTANCE_THRESHOLD=0.4

# Minimum persistence score (0.0–1.0)
PERSISTENCE_THRESHOLD=0.4

# Combined long-term memory decision threshold (0.0–1.0)
LONGTERM_THRESHOLD=0.70

# ── HTTP API / Frontend ─────────────────────────────────────
# Comma-separated browser origins permitted to call the API
CORS_ORIGINS=http://localhost:8501,http://localhost:5173

# ── Voice Subsystem (STT & TTS) ──────────────────────────────
# Whisper STT model size: tiny, base, small, medium, large-v3 (default: base)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional fixed language (e.g. en, hi, mr). Leave empty for auto-detect:
WHISPER_LANGUAGE=

# Text-to-Speech (pyttsx3) configuration
TTS_ENABLED=true
TTS_RATE=180
TTS_VOLUME=1.0
TTS_MAX_SPOKEN_WORDS=120
